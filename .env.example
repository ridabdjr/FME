# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PHASE 5 — TELECOMOPS 360 PRODUCTION BACKEND & SECURITY CONFIGURATION
# Server-side HMAC session signing key (never exposed to browser bundle)
TELECOMOPS_SESSION_SECRET="REPLACE_WITH_64_BYTE_HEX_SECRET_IN_PRODUCTION"

# Environment security mode: "development-demo" or "production-enforced"
TELECOMOPS_ENV_MODE="development-demo"

# Server-side GIS Map & Tile / Geocoding API Key (proxied via /api/gis/*)
GIS_MAP_API_KEY="cb1_50a2_1_35699cc2c825dc341309325e"
VITE_GIS_MAP_API_KEY="cb1_50a2_1_35699cc2c825dc341309325e"
VITE_CARTO_API_KEY="cb1_50a2_1_35699cc2c825dc341309325e"

# Optional OSS/NMS & Notification Provider Server Credentials (Simulated fallback when unset)
NOKIA_NETACT_API_URL=""
NOKIA_NETACT_CLIENT_SECRET=""
HUAWEI_NCE_RESTCONF_URL=""
HUAWEI_NCE_API_TOKEN=""
ERICSSON_ENM_VES_URL=""
SMTP_RELAY_HOST=""
SMTP_RELAY_SECRET=""
SMS_GATEWAY_API_KEY=""
